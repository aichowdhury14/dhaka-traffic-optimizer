# All optional — the app runs fully on bundled seed data with none of these set.

# Neon/Vercel Postgres connection string. When set, the app reads/writes live
# traffic data instead of the bundled seed JSON.
DATABASE_URL=

# TomTom Traffic API key (free tier: 2500 requests/day). When set alongside
# DATABASE_URL, /api/sync-tomtom pulls real congestion data into the database.
# Get one at https://developer.tomtom.com/
TOMTOM_API_KEY=

# Protects /api/sync-tomtom from public invocation. Required by Vercel Cron
# automatically when using vercel.json's crons config with this route.
CRON_SECRET=

# MapTiler API key for the vector basemap style. Free tier: 100k loads/month.
# Get one at https://cloud.maptiler.com/ — falls back to a basic demo style
# if unset.
NEXT_PUBLIC_MAPTILER_KEY=
